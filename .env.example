# ============================================================================
# 📝 GatewayEMS - Variables de Entorno
# ============================================================================
# 
# INSTRUCCIONES:
# 1. Copia este archivo como .env:
#    cp .env.example .env
# 
# 2. Edita los valores según tu entorno
# 
# 3. NUNCA commitees el archivo .env a Git (está en .gitignore)
#
# ============================================================================

# ============================================================================
# 🗄️ INFLUXDB - Configuración de la Base de Datos
# ============================================================================

# URL de conexión a InfluxDB
# Para Docker Compose: http://influxdb:8086
# Para InfluxDB local: http://localhost:8086
# Para InfluxDB remoto: http://tu-servidor.com:8086
INFLUXDB_URL=http://localhost:8086

# Token de autenticación de InfluxDB (mínimo 16 caracteres, recomendado 64)
# Genera uno seguro con cualquiera de estos comandos:
#   openssl rand -base64 64 | tr -d "=+/" | cut -c1-64
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# IMPORTANTE: Este token debe tener permisos de lectura/escritura en el bucket
INFLUXDB_TOKEN=tu_token_super_secreto_de_minimo_64_caracteres_aqui_cambiar

# Usuario administrador de InfluxDB
# Se crea automáticamente en el primer inicio de InfluxDB
INFLUXDB_ADMIN_USER=admin

# Contraseña del administrador (mínimo 8 caracteres, recomendado 16+)
# Usa una contraseña fuerte con letras, números y símbolos
INFLUXDB_ADMIN_PASSWORD=tu_password_seguro_aqui_cambiar

# Organización de InfluxDB (namespace para buckets)
# Puedes usar el nombre de tu empresa o proyecto
INFLUXDB_ORG=gateway_ems

# Bucket principal para almacenar datos Modbus
# Un bucket es como una "base de datos" en InfluxDB
INFLUXDB_BUCKET=modbus_data

# Retención de datos en días (después se eliminan automáticamente)
# Valores comunes:
#   7   = 1 semana
#   30  = 1 mes
#   90  = 3 meses (recomendado)
#   365 = 1 año
#   0   = infinito (sin límite)
INFLUXDB_RETENTION=90

# ============================================================================
# 🌐 INFLUXDB DEL SERVIDOR CENTRAL - Réplica (OPCIONAL)
# ============================================================================
#
# Además de guardar en local, el gateway puede subir sus lecturas a un InfluxDB
# central para que el servidor tenga la foto de toda la flota. Cada punto viaja
# con un tag `gateway_uuid`, así que en el servidor se distingue de qué equipo
# viene cada dato.
#
# Cómo funciona: una tarea relee del InfluxDB LOCAL desde una marca de agua
# guardada en disco y escribe en el servidor. El local hace de buffer, así que
# un corte de red se recupera solo cuando vuelve el enlace y un reinicio del
# proceso no pierde nada.
#
# Apagado por defecto. Si lo pones en true, las cuatro variables siguientes son
# obligatorias: el gateway se niega a arrancar si falta alguna.
INFLUXDB_SERVER_ACTIVE=false

# URL del InfluxDB central.
# ⚠️  Usa https:// en producción: con http:// el token viaja en claro.
INFLUXDB_SERVER_URL=https://tu-servidor.com:8086

# Token del servidor. Emite uno de SOLO ESCRITURA limitado al bucket de abajo;
# no repartas el token de administración entre los equipos de campo.
INFLUXDB_SERVER_TOKEN=cambiar-por-el-token-de-escritura-del-servidor

INFLUXDB_SERVER_ORG=cambiar-por-la-org-del-servidor
INFLUXDB_SERVER_BUCKET=cambiar-por-el-bucket-del-servidor

# Cada cuántos MINUTOS se sube el lote pendiente al servidor.
INFLUXDB_SERVER_INTERVAL_MINUTES=15

# ============================================================================
# 🔧 OPCIONALES - Configuración Avanzada
# ============================================================================

# Nivel de logging (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# LOG_LEVEL=INFO

# Puerto del servidor (si implementas API REST en el futuro)
# SERVER_PORT=8000

# Zona horaria (útil para timestamps)
# TIMEZONE=America/Mexico_City

# ============================================================================
# 📊 MONITOREO - Para integración futura con Grafana/Prometheus
# ============================================================================

# URL de Grafana (si usas visualización)
# GRAFANA_URL=http://localhost:3000

# API Key de Grafana
# GRAFANA_API_KEY=tu_grafana_api_key_aqui

# ============================================================================
# 🔐 SEGURIDAD - Notas Importantes
# ============================================================================
#
# ⚠️  NUNCA compartas este archivo .env públicamente
# ⚠️  NO lo commitees a Git (verifica .gitignore)
# ⚠️  Usa contraseñas diferentes en producción
# ⚠️  Rota tokens cada 90 días en producción
# ⚠️  Limita permisos del token solo a lo necesario
#
# ============================================================================

# ============================================================================
# 📡 MQTT - Publicación y recepción de mensajes (REQUERIDO)
# ============================================================================
#
# Todas estas variables son obligatorias: `Settings` falla al arrancar si
# alguna falta. Los tests las rellenan con valores de prueba desde
# tests/conftest.py.

# Interruptor general de MQTT.
#
#   true  (por defecto) — todo como siempre: publica telemetría, escucha al CRM
#                         y reporta presencia.
#   false — MODO AUTÓNOMO: el gateway sólo lee Modbus y guarda en su InfluxDB
#           local. Ni publica en el topic, ni escucha al CRM, ni manda
#           heartbeat. Su configuración sale ENTONCES SÓLO de config.ini: ese
#           equipo no se aprovisiona ni se actualiza desde el CRM hasta que se
#           vuelva a poner en true y se reinicie. A cambio, arranca aunque no
#           haya broker ni CRM levantados.
#
# La réplica al servidor central (INFLUXDB_SERVER_ACTIVE) es independiente: va
# por HTTP contra InfluxDB, no por MQTT, y sigue funcionando con esto en false.
MQTT_ACTIVE=true

# Broker
MQTT_HOST=localhost
MQTT_PORT=1883

# TLS contra el broker.
#
# Si mosquitto escucha TLS y esto está en false, la conexión NO da un error
# claro: el cliente manda su CONNECT en claro, el broker espera un ClientHello
# que no llega, y los dos se quedan esperando hasta "MqttError: timed out".
# Acuérdate de poner MQTT_PORT=8883.
#
# Se valida el certificado contra el almacén de confianza del SISTEMA, y se
# comprueba que el nombre del certificado sea el de MQTT_HOST. Con una CA propia
# hay que instalarla en el sistema (update-ca-certificates), y MQTT_HOST tiene
# que coincidir con el nombre del certificado: si el certificado es para un
# nombre y conectas por IP, la validación falla — con razón.
MQTT_USE_TLS=false

# Credenciales del broker
MQTT_USER=gateway
MQTT_PASSWORD=cambiar-en-produccion

# Identificador del cliente: debe ser único por gateway en el broker
MQTT_CLIENT_ID=gateway-ems-01

# Base del topic de telemetría Modbus. Cada equipo publica en su propio topic:
#   <base>/<device_id>/<identify_device>
#   gatewayems/modbus/74/7d8704bd-5fe0-4686-972e-a71febc718d7
# Para escuchar: <base>/+/<uuid> un equipo, <base>/<id>/+ un esclavo, <base>/# todo
MQTT_TOPIC_TLM=gateway/modbus/data
MQTT_TOPIC_CRM=crm/gateways

# Calidad de servicio: 0 (fire and forget), 1 (al menos una vez), 2 (exactamente una vez)
MQTT_QOS=1

# ============================================================================
# 🏢 CRM - configuración remota (REQUERIDO)
# ============================================================================
#
# El CRM avisa por MQTT en {MQTT_TOPIC_CRM}/{GATEWAY_UUID}/config y el gateway
# descarga la configuración por HTTP con su propia credencial.

# Base de la API del CRM
CRM_API_URL=http://localhost:8000/api/v1

# Credencial de larga vida del gateway. El CRM la enseña UNA sola vez al
# emitirla (POST /gateways/{id}/credential); no se puede recuperar después.
GATEWAY_CREDENTIAL=cambiar-por-la-credencial-del-crm

# Cada cuánto reportar presencia. Es también el camino que trae configuración
# pendiente cuando el broker MQTT está caído.
CRM_HEARTBEAT_SECONDS=60

# Timeout de las peticiones al CRM, en segundos
CRM_HTTP_TIMEOUT=30

# ============================================================================
# 🧪 TESTING - Variables para tests (opcional)
# ============================================================================

# Base de datos de prueba (para tests)
# INFLUXDB_BUCKET_TEST=modbus_data_test

# ============================================================================
